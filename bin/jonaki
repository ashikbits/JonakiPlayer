#!/bin/bash
# Jonaki for Linux - Executable Launcher
# High-performance libmpv multimedia player for Linux (X11 & XWayland).

REAL_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

PY_VER="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "3")"
export PYTHONPATH="$PROJECT_DIR/src:$HOME/.local/lib/python${PY_VER}/site-packages:$PYTHONPATH"
export LD_LIBRARY_PATH="$PROJECT_DIR/lib:$LD_LIBRARY_PATH"

# Display Server & XWayland Integration
if [ -n "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; then
    if ! command -v Xwayland >/dev/null 2>&1; then
        echo "[Jonaki] Notice: Running on Wayland without DISPLAY or Xwayland." >&2
        echo "JonakiPlayer embeds libmpv via X11 Window IDs (wid) and requires an X11 server or XWayland." >&2
    fi
fi

export GDK_BACKEND=x11
unset WAYLAND_DISPLAY

# Audio stream identification for PipeWire and PulseAudio mixers (KDE Plasma, GNOME Soundbar)
export PULSE_PROP="application.name='Jonaki' application.process.binary='jonaki' application.id='jonaki' application.desktop-entry='jonaki' application.icon_name='jonaki' media.role='video'"
export PIPEWIRE_APP_NAME="Jonaki"
export PIPEWIRE_APP_ICON="jonaki"
export PIPEWIRE_APP_ID="jonaki"

if [ -z "$VDPAU_DRIVER" ]; then
    if [ -f "/usr/lib/x86_64-linux-gnu/vdpau/libvdpau_radeonsi.so" ]; then
        export VDPAU_DRIVER=radeonsi
    elif [ -f "/usr/lib/x86_64-linux-gnu/vdpau/libvdpau_va_gl.so" ]; then
        export VDPAU_DRIVER=va_gl
    fi
fi

exec python3 "$PROJECT_DIR/src/jonaki.py" "$@"
